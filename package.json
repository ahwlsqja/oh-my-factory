{
  "name": "oh-my-factory",
  "version": "0.0.1",
  "description": "A goal-driven software factory for Claude Code and Codex CLI: humans decide, agents implement, and a hash-chained ledger records it",
  "author": "ahwlsqja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahwlsqja/oh-my-factory.git"
  },
  "bugs": {
    "url": "https://github.com/ahwlsqja/oh-my-factory/issues"
  },
  "homepage": "https://github.com/ahwlsqja/oh-my-factory#readme",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex-cli",
    "software-factory",
    "cli"
  ],
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "omf": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "picomatch": "4.0.7",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  }
}

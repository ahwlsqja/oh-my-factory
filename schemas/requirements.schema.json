{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMF requirement ids (M3h)",
  "description": "Validates docs/requirements.json: one entry per control claim, with the tests that carry it, whether it can only be believed after a recorded real-container run, the documents that make the claim, and, for a requirement whose mechanism lands later, the milestone it is deferred to. scripts/conformance-matrix.mjs reads it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirements"],
  "properties": {
    "schema_version": { "const": 1 },
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "claim"],
      "properties": {
        "id": { "type": "string", "pattern": "^(F[0-9]{1,2}|S[0-9]+(\\.[0-9]+)?)\\.[a-z0-9-]{3,40}$" },
        "source": { "type": "string", "minLength": 1, "maxLength": 80 },
        "claim": { "type": "string", "minLength": 1, "maxLength": 300 },
        "real_world": { "type": "boolean" },
        "surfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(README\\.md|docs/[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*\\.md)$" }
        },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } },
        "deferred_to": { "type": "string", "pattern": "^(M[0-9]+[a-z]?|v[0-9]+\\.[0-9]+|after v0\\.1)$" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(tests|outer)/([A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.(ts|mjs)$"
        },
        "gated": { "type": "string", "pattern": "^G-[a-z0-9-]+$", "maxLength": 80 },
        "proves": { "enum": ["behavior", "wiring_only"] }
      }
    }
  }
}

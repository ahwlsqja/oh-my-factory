{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMF judge harness protocol (M3f)",
  "description": "The four requests the host sends to the harness container over stdin, the replies it gets back, and the final verdict. Scenario refs and nonces are hex ids; no scenario id, canary, author, decision ref or assertion note can be expressed.",
  "$defs": {
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "scenario_ref": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "rep": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "stdin"],
      "properties": {
        "argv": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4096 } },
        "stdin": { "type": "string", "maxLength": 65536 }
      }
    },
    "stdout_match": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": { "kind": { "const": "exact" }, "text": { "type": "string", "maxLength": 8000 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": { "const": "anchored" },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      ]
    },
    "json_path_map": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 200 },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "maxLength": 2000 },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "stdout_matches", "json_path"],
      "properties": {
        "exit_code": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 255 }, { "type": "null" }] },
        "stdout_matches": { "anyOf": [{ "$ref": "#/$defs/stdout_match" }, { "type": "null" }] },
        "json_path": { "anyOf": [{ "$ref": "#/$defs/json_path_map" }, { "type": "null" }] }
      }
    },
    "harness_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "scenarios"],
      "properties": {
        "schema_version": { "const": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenario_ref", "steps"],
            "properties": {
              "scenario_ref": { "$ref": "#/$defs/scenario_ref" },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["invoke", "expect"],
                  "properties": {
                    "invoke": { "$ref": "#/$defs/invoke" },
                    "expect": { "$ref": "#/$defs/expect" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "exit_code", "stdout"],
          "properties": {
            "outcome": { "const": "exited" },
            "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
            "stdout": { "type": "string", "maxLength": 1048576 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "signal"],
          "properties": { "outcome": { "const": "signaled" }, "signal": { "type": "string", "maxLength": 64 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome"],
          "properties": { "outcome": { "enum": ["timeout", "output_limit", "error"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "code"],
          "properties": { "outcome": { "const": "refused" }, "code": { "type": "string", "maxLength": 64 } }
        }
      ]
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "nonce", "set"],
          "properties": {
            "op": { "const": "load" },
            "nonce": { "$ref": "#/$defs/nonce" },
            "set": { "$ref": "#/$defs/harness_set" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "nonce", "scenario_ref", "rep"],
          "properties": {
            "op": { "const": "begin" },
            "nonce": { "$ref": "#/$defs/nonce" },
            "scenario_ref": { "$ref": "#/$defs/scenario_ref" },
            "rep": { "$ref": "#/$defs/rep" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "nonce", "scenario_ref", "rep", "step_index", "observation"],
          "properties": {
            "op": { "const": "observe" },
            "nonce": { "$ref": "#/$defs/nonce" },
            "scenario_ref": { "$ref": "#/$defs/scenario_ref" },
            "rep": { "$ref": "#/$defs/rep" },
            "step_index": { "type": "integer", "minimum": 0, "maximum": 11 },
            "observation": { "$ref": "#/$defs/observation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "nonce"],
          "properties": { "op": { "const": "verdict" }, "nonce": { "$ref": "#/$defs/nonce" } }
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "nonce", "runs"],
      "properties": {
        "schema_version": { "const": 1 },
        "nonce": { "$ref": "#/$defs/nonce" },
        "runs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scenario_ref", "rep", "outcome", "steps_passed", "steps_total"],
            "properties": {
              "scenario_ref": { "$ref": "#/$defs/scenario_ref" },
              "rep": { "$ref": "#/$defs/rep" },
              "outcome": { "enum": ["pass", "fail", "error"] },
              "steps_passed": { "type": "integer", "minimum": 0, "maximum": 12 },
              "steps_total": { "type": "integer", "minimum": 1, "maximum": 12 }
            }
          }
        }
      }
    },
    "reply": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "nonce", "scenarios_total"],
          "properties": {
            "op": { "const": "load" },
            "nonce": { "$ref": "#/$defs/nonce" },
            "scenarios_total": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "nonce", "steps_total", "invoke"],
          "properties": {
            "op": { "const": "begin" },
            "nonce": { "$ref": "#/$defs/nonce" },
            "steps_total": { "type": "integer", "minimum": 1, "maximum": 12 },
            "invoke": { "$ref": "#/$defs/invoke" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "nonce", "step_pass", "next"],
          "properties": {
            "op": { "const": "observe" },
            "nonce": { "$ref": "#/$defs/nonce" },
            "step_pass": { "type": "boolean" },
            "next": { "anyOf": [{ "$ref": "#/$defs/invoke" }, { "type": "null" }] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "nonce", "verdict"],
          "properties": {
            "op": { "const": "verdict" },
            "nonce": { "$ref": "#/$defs/nonce" },
            "verdict": { "$ref": "#/$defs/verdict" }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMF minimal handoff record (M3b2, spec §6.3)",
  "description": "What a person needs when a run ends blocked, manual or flawed, or when a run was killed. Every string is an id, a timestamp, a member of a closed list or a fixed template sentence (printable ASCII), so nothing a model wrote and no metric text can enter. The full packet and omf answer are M4; resume is a placeholder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "work_id", "goal_id", "run_id", "predecessor_seq", "outcome", "reason_code",
    "state", "ran", "remaining", "risks", "decision_required", "resume", "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["outcome", "killed_predecessor"] },
    "work_id": { "$ref": "#/$defs/work_id" },
    "goal_id": { "$ref": "#/$defs/goal_id" },
    "run_id": { "$ref": "#/$defs/run_id" },
    "predecessor_seq": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
    "outcome": { "enum": ["flawed", "blocked", "manual"] },
    "reason_code": { "$ref": "#/$defs/reason_code" },
    "state": { "$ref": "#/$defs/sentence" },
    "ran": {
      "type": "array",
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "result"],
        "properties": {
          "node": { "$ref": "#/$defs/node" },
          "result": { "type": "string", "pattern": "^[a-z_]{1,40}$" }
        }
      }
    },
    "remaining": { "type": "array", "maxItems": 11, "items": { "$ref": "#/$defs/node" } },
    "risks": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/risk" } },
    "decision_required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["j", "question", "options"],
      "properties": {
        "j": { "enum": ["J2", "J3", "J4", "J6", "J7", "J8"] },
        "question": { "$ref": "#/$defs/sentence" },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^(omf|after M3h: omf) [ -~]{1,150}$" }
        }
      }
    },
    "resume": { "const": "not_available_until_m4" },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "if": { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "killed_predecessor" } } },
      "then": {
        "type": "object",
        "properties": {
          "predecessor_seq": { "type": "integer" },
          "outcome": { "const": "blocked" },
          "reason_code": { "const": "run_killed" }
        }
      },
      "else": { "type": "object", "properties": { "predecessor_seq": { "type": "null" } } }
    }
  ],
  "$defs": {
    "goal_id": { "type": "string", "pattern": "^g-[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "work_id": { "type": "string", "pattern": "^w-[0-9a-f]{12}$" },
    "run_id": { "type": "string", "pattern": "^r-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "sentence": { "type": "string", "pattern": "^[ -~]{1,300}$" },
    "node": { "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "GATE-1", "GATE-2", "GATE-3", "GATE-4"] },
    "reason_code": {
      "enum": [
        "j2_open", "gate_blocked", "budget_exhausted", "infra_failure", "manual_required", "station_error",
        "visit_cap", "stalled", "gate_not_run", "station_skipped", "evidence_incomplete", "run_killed",
        "audit_flag", "sealed_failed", "flaky_scenario", "within_variance", "gate2_exhausted", "reentry_loop",
        "scenarios_need_review"
      ]
    },
    "risk": {
      "enum": [
        "decision_unmeasured", "model_spend_unverifiable", "noise_check_not_run", "noise_check_not_evaluated",
        "high_risk_paths_not_run", "high_risk_paths_touched", "decisions_masked", "injected_gate"
      ]
    }
  }
}

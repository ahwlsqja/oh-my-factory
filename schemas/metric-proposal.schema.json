{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMF metric proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metric_id", "command", "unit", "watched_paths", "image", "owner", "proposed_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "metric_id": { "type": "string", "pattern": "^m-[a-z0-9]+(-[a-z0-9]+)*$" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "unit": { "type": "string", "minLength": 1 },
    "watched_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "image": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "owner": { "type": "string", "pattern": "^human:\\S+$" },
    "proposed_at": { "type": "string", "minLength": 1 }
  }
}

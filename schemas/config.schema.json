{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMF config.toml (host state, spec §11.5)",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": { "enum": ["claude", "codex"] },
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "minLength": 1 }
      }
    },
    "implementer_role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vendor": { "enum": ["claude", "codex"] },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$" },
        "effort": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declared": { "enum": ["L2"] }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "$ref": "#/$defs/role" },
        "implementer": { "$ref": "#/$defs/implementer_role" },
        "judge": { "$ref": "#/$defs/role" },
        "reconciler": { "$ref": "#/$defs/role" }
      }
    },
    "reconciler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["claude", "command"] },
        "model": { "type": "string", "minLength": 1 },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "auth": { "enum": ["api_key"] },
        "env_passthrough": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "max_budget_usd": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "w": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_rounds": { "type": "integer", "minimum": 1, "maximum": 50 },
        "max_model_usd": { "type": "number", "minimum": 0.000001, "maximum": 10000 }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "k": { "type": "integer", "minimum": 2, "maximum": 10 },
        "sut_base_image": { "type": "string", "minLength": 1 },
        "harness_base_image": { "type": "string", "minLength": 1 },
        "docker_context": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "step_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "memory_mb": { "type": "integer", "minimum": 64, "maximum": 4096 },
        "cpus": { "type": "number", "minimum": 0.1, "maximum": 4, "multipleOf": 0.01 },
        "pids_limit": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "tmp_tmpfs_mb": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "scratch_tmpfs_mb": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "work_tmpfs_mb": { "type": "integer", "minimum": 16, "maximum": 2048 },
        "state_tmpfs_mb": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "implementer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 60000, "maximum": 14400000 },
        "memory_mb": { "type": "integer", "minimum": 256, "maximum": 16384 },
        "cpus": { "type": "number", "minimum": 0.1, "maximum": 16, "multipleOf": 0.01 },
        "pids_limit": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "tmp_tmpfs_mb": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "work_tmpfs_mb": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "agent_tmpfs_mb": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "max_log_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 },
        "max_workspace_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "timeout_ms": { "type": "integer", "minimum": 60000, "maximum": 3600000 },
        "max_output_bytes": { "type": "integer", "minimum": 65536, "maximum": 16777216 },
        "max_calls": { "type": "integer", "minimum": 1, "maximum": 100 },
        "memory_mb": { "type": "integer", "minimum": 256, "maximum": 8192 },
        "cpus": { "type": "number", "minimum": 0.1, "maximum": 8, "multipleOf": 0.01 },
        "pids_limit": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "tmp_tmpfs_mb": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "in_tmpfs_mb": { "type": "integer", "minimum": 1, "maximum": 256 },
        "out_tmpfs_mb": { "type": "integer", "minimum": 1, "maximum": 256 },
        "agent_tmpfs_mb": { "type": "integer", "minimum": 16, "maximum": 1024 }
      }
    }
  }
}

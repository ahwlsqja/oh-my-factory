{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMF scenarios (M3c, spec §5.2, §5.3)",
  "$defs": {
    "decision_id": { "type": "string", "pattern": "^d-[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "scenario_id": { "type": "string", "pattern": "^s-[0-9a-f]{32}$" },
    "canary": { "type": "string", "pattern": "^omf-canary-[0-9a-f]{32}$" },
    "scenario_ref": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\p{Cc}\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]+$" }
    },
    "cli_invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": { "$ref": "#/$defs/argv" },
        "stdin": { "type": "string", "maxLength": 8000 }
      }
    },
    "http_invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "body": { "type": "string", "maxLength": 8000 }
      }
    },
    "stdout_match": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": { "kind": { "const": "exact" }, "text": { "type": "string", "maxLength": 8000 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": { "kind": { "const": "anchored" }, "pattern": { "type": "string", "minLength": 1, "maxLength": 512 } }
        }
      ]
    },
    "json_path_map": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 200 },
      "additionalProperties": {
        "anyOf": [{ "type": "string", "maxLength": 2000 }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }]
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 255 }, { "type": "null" }] },
        "stdout_matches": { "anyOf": [{ "$ref": "#/$defs/stdout_match" }, { "type": "null" }] },
        "json_path": { "anyOf": [{ "$ref": "#/$defs/json_path_map" }, { "type": "null" }] },
        "note": { "type": "string", "maxLength": 500, "pattern": "^[^\\p{Cc}\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$" }
      }
    },
    "authored_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoke", "expect"],
      "properties": {
        "invoke": { "anyOf": [{ "$ref": "#/$defs/cli_invoke" }, { "$ref": "#/$defs/http_invoke" }] },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "authored_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "split", "interface", "steps"],
      "properties": {
        "decision_refs": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "$ref": "#/$defs/decision_id" } },
        "kind": { "enum": ["behavior", "nfr", "contradiction_canary"] },
        "split": { "enum": ["train", "test"] },
        "interface": { "enum": ["cli", "http"] },
        "steps": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/authored_step" } },
        "nfr_probe": {},
        "schema_version": {},
        "scenario_id": {},
        "work_id": {},
        "author": {},
        "canary": {},
        "exposure": {},
        "status": {}
      }
    },
    "author_stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "model", "at", "isolation"],
      "properties": {
        "vendor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$" },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$" },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
        "isolation": { "enum": ["host_command", "container"] }
      }
    },
    "stored_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoke", "expect"],
      "properties": {
        "invoke": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv", "stdin"],
          "properties": { "argv": { "$ref": "#/$defs/argv" }, "stdin": { "type": "string", "maxLength": 8000 } }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit_code", "stdout_matches", "json_path", "note"],
          "properties": {
            "exit_code": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 255 }, { "type": "null" }] },
            "stdout_matches": { "anyOf": [{ "$ref": "#/$defs/stdout_match" }, { "type": "null" }] },
            "json_path": { "anyOf": [{ "$ref": "#/$defs/json_path_map" }, { "type": "null" }] },
            "note": { "type": "string", "maxLength": 560, "pattern": "^omf-canary-[0-9a-f]{32}( [^\\p{Cc}\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*)?$" }
          },
          "not": {
            "type": "object",
            "properties": { "exit_code": { "type": "null" }, "stdout_matches": { "type": "null" }, "json_path": { "type": "null" } }
          }
        }
      }
    },
    "stored_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "scenario_id", "work_id", "author", "decision_refs", "kind", "split", "interface", "steps", "canary"],
      "properties": {
        "schema_version": { "const": 1 },
        "scenario_id": { "$ref": "#/$defs/scenario_id" },
        "work_id": { "type": "string", "pattern": "^w-[0-9a-f]{12}$" },
        "author": { "$ref": "#/$defs/author_stamp" },
        "decision_refs": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "$ref": "#/$defs/decision_id" } },
        "kind": { "enum": ["behavior", "contradiction_canary"] },
        "split": { "enum": ["train", "test"] },
        "interface": { "const": "cli" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/stored_step" } },
        "canary": { "$ref": "#/$defs/canary" }
      }
    }
  }
}

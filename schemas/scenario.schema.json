{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMF scenarios (M3c, spec §5.2, §5.3)",
  "$defs": {
    "ev_goal_id": { "type": "string", "pattern": "^g-[a-z0-9]+(-[a-z0-9]+)*$" },
    "ev_work_id": { "type": "string", "pattern": "^w-[0-9a-f]{12}$" },
    "ev_seal_id": { "type": "string", "pattern": "^seal-[0-9a-f]{16}$" },
    "ev_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ev_ref": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "ev_decision_id": { "type": "string", "pattern": "^d-[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "ev_count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "ev_round": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "ev_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "ev_label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,79}$" },
    "ev_isolation": { "enum": ["host_command", "container"] },
    "ev_author_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "model", "isolation"],
      "properties": {
        "vendor": { "$ref": "#/$defs/ev_label" },
        "model": { "$ref": "#/$defs/ev_label" },
        "isolation": { "$ref": "#/$defs/ev_isolation" }
      }
    },
    "ev_author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "model", "at", "isolation"],
      "properties": {
        "vendor": { "$ref": "#/$defs/ev_label" },
        "model": { "$ref": "#/$defs/ev_label" },
        "at": { "$ref": "#/$defs/ev_timestamp" },
        "isolation": { "$ref": "#/$defs/ev_isolation" }
      }
    },
    "ev_seal_requested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "work_id", "round", "author", "input_sha256", "decisions_digest", "feedback"],
      "properties": {
        "goal_id": { "$ref": "#/$defs/ev_goal_id" },
        "work_id": { "$ref": "#/$defs/ev_work_id" },
        "round": { "$ref": "#/$defs/ev_round" },
        "author": { "$ref": "#/$defs/ev_author_ref" },
        "input_sha256": { "$ref": "#/$defs/ev_digest" },
        "decisions_digest": { "$ref": "#/$defs/ev_digest" },
        "feedback": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["unlinked_decision_count", "weak", "contradictions", "invalid"],
              "properties": {
                "unlinked_decision_count": { "$ref": "#/$defs/ev_count" },
                "weak": { "$ref": "#/$defs/ev_count" },
                "contradictions": { "$ref": "#/$defs/ev_count" },
                "invalid": { "$ref": "#/$defs/ev_count" }
              }
            }
          ]
        }
      }
    },
    "ev_seal_completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "work_id",
        "round",
        "seal_id",
        "author",
        "decisions_digest",
        "set_sha256",
        "counts",
        "rejected_by_code"
      ],
      "properties": {
        "goal_id": { "$ref": "#/$defs/ev_goal_id" },
        "work_id": { "$ref": "#/$defs/ev_work_id" },
        "round": { "$ref": "#/$defs/ev_round" },
        "seal_id": { "$ref": "#/$defs/ev_seal_id" },
        "author": { "$ref": "#/$defs/ev_author" },
        "decisions_digest": { "$ref": "#/$defs/ev_digest" },
        "set_sha256": { "$ref": "#/$defs/ev_digest" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authored",
            "stored",
            "behavior",
            "contradiction_canary",
            "train",
            "test",
            "rejected",
            "ignored_fields"
          ],
          "properties": {
            "authored": { "$ref": "#/$defs/ev_count" },
            "stored": { "$ref": "#/$defs/ev_count" },
            "behavior": { "$ref": "#/$defs/ev_count" },
            "contradiction_canary": { "$ref": "#/$defs/ev_count" },
            "train": { "$ref": "#/$defs/ev_count" },
            "test": { "$ref": "#/$defs/ev_count" },
            "rejected": { "$ref": "#/$defs/ev_count" },
            "ignored_fields": { "$ref": "#/$defs/ev_count" }
          }
        },
        "rejected_by_code": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": { "pattern": "^[a-z][a-z_]{0,39}$" },
          "additionalProperties": { "$ref": "#/$defs/ev_count" }
        }
      }
    },
    "ev_seal_failed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "work_id", "round", "code", "duration_ms"],
      "properties": {
        "goal_id": { "$ref": "#/$defs/ev_goal_id" },
        "work_id": { "$ref": "#/$defs/ev_work_id" },
        "round": { "$ref": "#/$defs/ev_round" },
        "code": {
          "enum": [
            "timeout",
            "spawn_failed",
            "nonzero_exit",
            "no_output",
            "output_limit",
            "misconfigured",
            "not_golden",
            "container_failed",
            "credential_in_output",
            "no_valid_scenarios",
            "write_failed"
          ]
        },
        "duration_ms": { "$ref": "#/$defs/ev_count" }
      }
    },
    "ev_scenario_status_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_id", "work_id", "seal_id", "scenario_ref", "status", "reason"],
      "properties": {
        "goal_id": { "$ref": "#/$defs/ev_goal_id" },
        "work_id": { "$ref": "#/$defs/ev_work_id" },
        "seal_id": { "$ref": "#/$defs/ev_seal_id" },
        "scenario_ref": { "$ref": "#/$defs/ev_ref" },
        "status": { "enum": ["retired", "contaminated"] },
        "reason": { "enum": ["canary_hit", "exposure_limit", "person_retired", "contradiction"] }
      }
    },
    "ev_gate2_evaluated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "work_id",
        "round",
        "seal_id",
        "status",
        "route",
        "reason_codes",
        "unlinked_decision_ids",
        "not_run_decision_ids",
        "counts",
        "set_sha256",
        "decisions_digest",
        "feedback_counts"
      ],
      "properties": {
        "goal_id": { "$ref": "#/$defs/ev_goal_id" },
        "work_id": { "$ref": "#/$defs/ev_work_id" },
        "round": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "seal_id": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ev_seal_id" }] },
        "status": { "enum": ["pass", "fail"] },
        "route": { "anyOf": [{ "type": "null" }, { "enum": ["J2", "J3", "J7", "back_to_S2"] }] },
        "reason_codes": {
          "type": "array",
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "enum": [
              "gate1_not_passing",
              "ledger_anomaly",
              "seal_missing",
              "seal_after_start",
              "set_missing",
              "set_unreadable",
              "set_tampered",
              "decisions_drifted",
              "no_active_scenarios",
              "split_missing",
              "canary_missing",
              "scenario_invalid",
              "exposure_exhausted",
              "null_impl_passes",
              "contradiction",
              "judge_broken_or_gamed",
              "probe_error",
              "unlinked_decisions"
            ]
          }
        },
        "unlinked_decision_ids": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/ev_decision_id" } },
        "not_run_decision_ids": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/ev_decision_id" } },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active", "behavior_train", "behavior_test", "canaries", "contaminated", "retired"],
          "properties": {
            "active": { "$ref": "#/$defs/ev_count" },
            "behavior_train": { "$ref": "#/$defs/ev_count" },
            "behavior_test": { "$ref": "#/$defs/ev_count" },
            "canaries": { "$ref": "#/$defs/ev_count" },
            "contaminated": { "$ref": "#/$defs/ev_count" },
            "retired": { "$ref": "#/$defs/ev_count" }
          }
        },
        "set_sha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ev_digest" }] },
        "decisions_digest": { "$ref": "#/$defs/ev_digest" },
        "feedback_counts": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["weak", "contradictions", "invalid"],
              "properties": {
                "weak": { "$ref": "#/$defs/ev_count" },
                "contradictions": { "$ref": "#/$defs/ev_count" },
                "invalid": { "$ref": "#/$defs/ev_count" }
              }
            }
          ]
        }
      }
    },
    "decision_id": { "type": "string", "pattern": "^d-[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "scenario_id": { "type": "string", "pattern": "^s-[0-9a-f]{32}$" },
    "canary": { "type": "string", "pattern": "^omf-canary-[0-9a-f]{32}$" },
    "scenario_ref": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "^[^\\p{Cc}\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]+$"
      }
    },
    "cli_invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": { "$ref": "#/$defs/argv" },
        "stdin": { "type": "string", "maxLength": 8000 }
      }
    },
    "http_invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 500 },
        "body": { "type": "string", "maxLength": 8000 }
      }
    },
    "stdout_match": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": { "kind": { "const": "exact" }, "text": { "type": "string", "maxLength": 8000 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pattern"],
          "properties": {
            "kind": { "const": "anchored" },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      ]
    },
    "json_path_map": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 200 },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "maxLength": 2000 },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 255 }, { "type": "null" }] },
        "stdout_matches": { "anyOf": [{ "$ref": "#/$defs/stdout_match" }, { "type": "null" }] },
        "json_path": { "anyOf": [{ "$ref": "#/$defs/json_path_map" }, { "type": "null" }] },
        "note": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^[^\\p{Cc}\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*$"
        }
      }
    },
    "authored_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoke", "expect"],
      "properties": {
        "invoke": { "anyOf": [{ "$ref": "#/$defs/cli_invoke" }, { "$ref": "#/$defs/http_invoke" }] },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "authored_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "split", "interface", "steps"],
      "properties": {
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/decision_id" }
        },
        "kind": { "enum": ["behavior", "nfr", "contradiction_canary"] },
        "split": { "enum": ["train", "test"] },
        "interface": { "enum": ["cli", "http"] },
        "steps": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/authored_step" } },
        "nfr_probe": {},
        "schema_version": {},
        "scenario_id": {},
        "work_id": {},
        "author": {},
        "canary": {},
        "exposure": {},
        "status": {}
      }
    },
    "author_stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "model", "at", "isolation"],
      "properties": {
        "vendor": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$" },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$" },
        "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
        "isolation": { "enum": ["host_command", "container"] }
      }
    },
    "stored_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoke", "expect"],
      "properties": {
        "invoke": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv", "stdin"],
          "properties": { "argv": { "$ref": "#/$defs/argv" }, "stdin": { "type": "string", "maxLength": 8000 } }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit_code", "stdout_matches", "json_path", "note"],
          "properties": {
            "exit_code": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 255 }, { "type": "null" }] },
            "stdout_matches": { "anyOf": [{ "$ref": "#/$defs/stdout_match" }, { "type": "null" }] },
            "json_path": { "anyOf": [{ "$ref": "#/$defs/json_path_map" }, { "type": "null" }] },
            "note": {
              "type": "string",
              "maxLength": 560,
              "pattern": "^omf-canary-[0-9a-f]{32}( [^\\p{Cc}\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069]*)?$"
            }
          },
          "not": {
            "type": "object",
            "properties": {
              "exit_code": { "type": "null" },
              "stdout_matches": { "type": "null" },
              "json_path": { "type": "null" }
            }
          }
        }
      }
    },
    "stored_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scenario_id",
        "work_id",
        "author",
        "decision_refs",
        "kind",
        "split",
        "interface",
        "steps",
        "canary"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "scenario_id": { "$ref": "#/$defs/scenario_id" },
        "work_id": { "type": "string", "pattern": "^w-[0-9a-f]{12}$" },
        "author": { "$ref": "#/$defs/author_stamp" },
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/decision_id" }
        },
        "kind": { "enum": ["behavior", "contradiction_canary"] },
        "split": { "enum": ["train", "test"] },
        "interface": { "const": "cli" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/stored_step" } },
        "canary": { "$ref": "#/$defs/canary" }
      }
    }
  }
}

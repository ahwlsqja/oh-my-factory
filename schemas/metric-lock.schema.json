{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMF metric lock (metrics.lock, spec §4.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "metric_id",
    "command",
    "unit",
    "watched_paths",
    "image",
    "owner",
    "approved_by",
    "approved_at",
    "sha256",
    "regime"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "goal_id": { "type": "string", "pattern": "^g-[a-z0-9]+(-[a-z0-9]+)*$" },
    "metric_id": { "type": "string", "pattern": "^m-[a-z0-9]+(-[a-z0-9]+)*$" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "unit": { "type": "string", "minLength": 1 },
    "watched_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "image": { "anyOf": [{ "type": "string", "minLength": 1, "pattern": "^[^\\s-]\\S*$" }, { "type": "null" }] },
    "owner": { "type": "string", "pattern": "^human:\\S+$" },
    "approved_by": { "type": "string", "pattern": "^human:\\S+$" },
    "approved_at": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "regime": { "type": "integer", "minimum": 1 }
  }
}

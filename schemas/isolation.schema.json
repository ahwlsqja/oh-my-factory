{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMF per-run isolation measurements (M3e)",
  "description": "Validates <item>/runs/<run_id>/isolation.json: a list of measurements per stage. The file is a host-only view of the ledger events. It holds mount sources, destinations and environment variable NAMES, never a value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "stages", "level"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/run_id" },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "implementer", "sut", "harness"],
      "properties": {
        "author": { "$ref": "#/$defs/measurement_list" },
        "implementer": { "$ref": "#/$defs/measurement_list" },
        "sut": { "$ref": "#/$defs/measurement_list" },
        "harness": { "$ref": "#/$defs/measurement_list" }
      }
    },
    "level": { "enum": ["unmeasured", "L1", "L2", "L3"] }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^r-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "short_text": { "type": "string", "maxLength": 4096 },
    "text_list": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/short_text" } },
    "violation_code": {
      "enum": [
        "no_container", "docker_socket_mounted", "docker_socket_present", "privileged", "cap_added", "caps_not_dropped",
        "host_network", "network_not_none", "host_pid", "root_user", "rootfs_writable", "unexpected_mount", "mount_not_read_only",
        "forbidden_mount_source", "unexpected_env_name", "vendor_binary_present", "credential_present",
        "no_new_privileges_missing", "security_opt_unconfined", "device_mapped", "host_ipc", "host_uts", "userns_host", "volumes_from",
        "sysctl_set", "runtime_unexpected"
      ]
    },
    "mount_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "destination", "read_only"],
      "properties": {
        "type": { "enum": ["bind", "volume", "tmpfs", "other"] },
        "source": { "$ref": "#/$defs/short_text" },
        "destination": { "$ref": "#/$defs/short_text" },
        "read_only": { "type": "boolean" }
      }
    },
    "container_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_id", "image", "mounts", "env_names", "cap_add", "cap_drop", "privileged", "network_mode", "pid_mode", "user",
        "read_only_rootfs", "security_opt", "devices", "ipc_mode", "uts_mode", "userns_mode", "cgroupns_mode", "volumes_from",
        "sysctls", "runtime"
      ],
      "properties": {
        "container_id": { "$ref": "#/$defs/short_text" },
        "image": { "$ref": "#/$defs/short_text" },
        "mounts": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/mount_fact" } },
        "env_names": { "$ref": "#/$defs/text_list" },
        "cap_add": { "$ref": "#/$defs/text_list" },
        "cap_drop": { "$ref": "#/$defs/text_list" },
        "privileged": { "type": "boolean" },
        "network_mode": { "$ref": "#/$defs/short_text" },
        "pid_mode": { "$ref": "#/$defs/short_text" },
        "user": { "$ref": "#/$defs/short_text" },
        "read_only_rootfs": { "type": "boolean" },
        "security_opt": { "$ref": "#/$defs/text_list" },
        "devices": { "$ref": "#/$defs/text_list" },
        "ipc_mode": { "$ref": "#/$defs/short_text" },
        "uts_mode": { "$ref": "#/$defs/short_text" },
        "userns_mode": { "$ref": "#/$defs/short_text" },
        "cgroupns_mode": { "$ref": "#/$defs/short_text" },
        "volumes_from": { "$ref": "#/$defs/text_list" },
        "sysctls": { "$ref": "#/$defs/text_list" },
        "runtime": { "$ref": "#/$defs/short_text" }
      }
    },
    "container_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor_binaries", "credential_paths", "docker_socket_present"],
      "properties": {
        "vendor_binaries": { "$ref": "#/$defs/text_list" },
        "credential_paths": { "$ref": "#/$defs/text_list" },
        "docker_socket_present": { "type": "boolean" }
      }
    },
    "stage_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "mode", "measured_at", "facts", "checks", "level", "violations", "facts_sha256"],
      "properties": {
        "stage": { "enum": ["author", "implementer", "sut", "harness"] },
        "mode": { "enum": ["container", "host"] },
        "measured_at": { "$ref": "#/$defs/timestamp" },
        "facts": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/container_facts" }] },
        "checks": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/container_checks" }] },
        "level": { "enum": ["L1", "L2"] },
        "violations": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "$ref": "#/$defs/violation_code" } },
        "facts_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "allOf": [
        { "if": { "properties": { "level": { "const": "L2" } }, "required": ["level"] }, "then": { "properties": { "violations": { "type": "array", "maxItems": 0 }, "mode": { "type": "string", "const": "container" } } } }
      ]
    },
    "measurement_list": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/stage_measurement" } }
  }
}
